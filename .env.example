# Memory backend: "hindsight" (Hindsight Cloud) or "local" (offline JSON file)
MEMORY_BACKEND=hindsight

# Hindsight Cloud: https://ui.hindsight.vectorize.io
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recallops-acme-sre

# LLM used by the agent for triage (Groq, OpenAI-compatible endpoint)
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Band desktop: create a remote agent named "RecallOps", then paste its UUID and API key.
# Leave blank to run the dashboard only.
BAND_AGENT_ID=
BAND_API_KEY=
